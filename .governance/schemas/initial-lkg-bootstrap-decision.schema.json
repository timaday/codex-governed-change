{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/authority/initial-lkg-bootstrap-decision.schema.json",
  "title": "One-time protected initial-LKG bootstrap decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "repository_id",
    "decision_type",
    "task_contract_sha256",
    "candidate_id",
    "base_commit",
    "effective_policy_sha256",
    "scope",
    "issuer",
    "issued_at",
    "expires_at",
    "single_use",
    "consumption_id"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository_id": {"type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$"},
    "decision_type": {"const": "lkg_bootstrap"},
    "task_contract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "effective_policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "authentication_method", "protected_source", "assertion_sha256"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "authentication_method": {"type": "string", "minLength": 1},
        "protected_source": {"type": "string", "minLength": 1},
        "assertion_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "single_use": {"const": true},
    "consumption_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
