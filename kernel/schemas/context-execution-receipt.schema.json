{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/context-execution-receipt.schema.json",
  "title": "Post-run governed model context receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_receipt_id", "repository_id", "candidate_id", "input_context_receipt_sha256", "projection_sha256", "review_mode", "reviewer_output_sha256", "model", "reasoning_effort", "retrieval_expansions", "usage_observed", "input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "latency_ms", "cost", "created_at", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "execution_receipt_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "input_context_receipt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "projection_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "review_mode": { "enum": ["conformance", "rapid_review"] },
    "reviewer_output_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "model": { "type": "string", "minLength": 1 },
    "reasoning_effort": { "enum": ["high", "xhigh"] },
    "retrieval_expansions": { "type": "array", "items": { "$ref": "#/$defs/expansion" } },
    "usage_observed": { "type": "boolean" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "cached_input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "reasoning_output_tokens": { "type": "integer", "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cost": { "type": "string" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256", "level", "reason"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "level": { "enum": ["typed_summary", "relevant_excerpt", "complete_artifact"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
