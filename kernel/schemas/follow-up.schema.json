{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/follow-up.schema.json",
  "title": "Rapid-review follow-up risk or charter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "follow_up_id", "repository_id", "task_contract_sha256", "candidate_id", "kind", "source_kind", "source_id", "description", "priority", "required", "status", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "follow_up_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "kind": { "enum": ["risk", "charter"] },
    "source_kind": { "enum": ["requirement", "change", "observation", "mutant", "reviewer_finding", "debrief"] },
    "source_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "priority": { "enum": ["low", "medium", "high", "critical"] },
    "required": { "type": "boolean" },
    "status": { "enum": ["open", "completed", "deferred", "unknown"] },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
