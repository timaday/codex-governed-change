{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/oracle-reference.schema.json",
  "title": "Fallible rapid-review oracle reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "oracle_id", "repository_id", "task_contract_sha256", "candidate_id", "name", "source", "source_sha256", "heuristic", "known_fallibility", "applicability", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "oracle_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "name": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "heuristic": { "type": "string", "minLength": 1 },
    "known_fallibility": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "applicability": { "type": "string", "minLength": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
