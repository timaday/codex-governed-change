{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/rapid-review-debrief.schema.json",
  "title": "RST-inspired rapid-review debrief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "task_contract_sha256", "debrief_id", "candidate_id", "session_refs", "product_story", "testing_story", "quality_of_testing_story", "actionable_findings", "residual_risks", "created_at", "producer_version", "provenance"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "debrief_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "session_refs": { "$ref": "#/$defs/nonemptyStrings" },
    "product_story": { "$ref": "#/$defs/story" },
    "testing_story": { "$ref": "#/$defs/story" },
    "quality_of_testing_story": { "$ref": "#/$defs/story" },
    "actionable_findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "residual_risks": { "$ref": "#/$defs/nonemptyStrings" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "producer_version": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "nonemptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence_refs", "limitations"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": { "$ref": "#/$defs/nonemptyStrings" },
        "limitations": { "$ref": "#/$defs/nonemptyStrings" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produced_by", "method", "source_refs"],
      "properties": {
        "produced_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/nonemptyStrings" }
      }
    }
  }
}
