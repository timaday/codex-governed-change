{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/assurance-case.schema.json",
  "title": "Deterministic governed-change assurance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assurance_case_id", "repository_id", "candidate_id", "task_contract_sha256", "effective_policy_sha256", "claims", "unresolved_defeaters", "state", "created_at", "producer_version"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "assurance_case_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "effective_policy_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "claims": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "argument_rule", "supporting_evidence", "refuting_evidence", "limitations", "unresolved_defeaters", "classification"],
        "properties": {
          "claim_id": { "enum": ["scope_authorized", "candidate_current", "gates_complete", "governance_integrity", "rst_complete", "mutation_complete", "fresh_review_complete", "residual_risk_visible", "context_complete"] },
          "argument_rule": { "type": "string", "pattern": "^[A-Z][A-Z0-9._-]{2,127}$" },
          "supporting_evidence": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
          "refuting_evidence": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "unresolved_defeaters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "classification": { "enum": ["DIRECTLY_OBSERVED", "VERIFIED_WITHIN_SCOPE", "UNVERIFIED", "UNKNOWN", "REFUTED"] }
        }
      }
    },
    "unresolved_defeaters": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "state": { "enum": ["READY_FOR_HUMAN", "BLOCK", "UNKNOWN"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "producer_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator_id", "sha256"],
      "properties": {
        "locator_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
