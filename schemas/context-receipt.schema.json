{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/context-receipt.schema.json",
  "title": "Deterministic model-context receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "repository_id", "candidate_id", "projection_version", "profile", "source_sha256", "projection_sha256", "included_sources", "excluded_sources", "estimated_input_tokens", "actual_input_tokens", "actual_output_tokens", "cached_input_tokens", "prompt_bytes", "evidence_bytes", "retrieval_expansions", "truncation_status", "model", "reasoning_effort", "latency_ms", "cost", "quality_metrics", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "receipt_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "projection_version": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["COMPACT", "STANDARD", "DEEP"] },
    "source_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "projection_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "included_sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "excluded_sources": { "type": "array", "items": { "$ref": "#/$defs/excluded" } },
    "estimated_input_tokens": { "type": "integer", "minimum": 0 },
    "actual_input_tokens": { "type": "integer", "minimum": 0 },
    "actual_output_tokens": { "type": "integer", "minimum": 0 },
    "cached_input_tokens": { "type": "integer", "minimum": 0 },
    "prompt_bytes": { "type": "integer", "minimum": 0 },
    "evidence_bytes": { "type": "integer", "minimum": 0 },
    "retrieval_expansions": { "type": "array", "items": { "$ref": "#/$defs/expansion" } },
    "truncation_status": { "enum": ["NONE", "OPTIONAL_REFERENCED", "CONTEXT_BUDGET_INSUFFICIENT"] },
    "model": { "type": "string", "minLength": 1 },
    "reasoning_effort": { "enum": ["low", "medium", "high", "xhigh"] },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cost": { "type": "string" },
    "quality_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical_defect_recall", "false_passes", "false_blocks", "mutation_kill_rate", "evidence_traceability", "unresolved_unknowns"],
      "properties": {
        "critical_defect_recall": { "type": "string", "minLength": 1 },
        "false_passes": { "type": "integer", "minimum": 0 },
        "false_blocks": { "type": "integer", "minimum": 0 },
        "mutation_kill_rate": { "type": "string", "minLength": 1 },
        "evidence_traceability": { "type": "string", "minLength": 1 },
        "unresolved_unknowns": { "type": "integer", "minimum": 0 }
      }
    },
    "created_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "sha256"],
      "properties": {
        "kind": { "enum": ["authority", "policy", "inventory", "change", "closure", "gate", "risk", "mutation", "review", "limitation", "unknown", "rubric"] },
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "excluded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256", "reason"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reason": { "enum": ["unchanged_content_addressed", "unaffected_large_artifact", "available_by_retrieval", "duplicate"] }
      }
    },
    "expansion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "sha256", "level", "reason"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "level": { "enum": ["typed_summary", "relevant_excerpt", "complete_artifact"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
