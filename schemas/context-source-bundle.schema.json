{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/context-source-bundle.schema.json",
  "title": "Protected deterministic context source bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_bundle_id", "repository_id", "candidate_id", "effective_policy_sha256", "requested_profile", "token_budget", "model", "reasoning_effort", "sources", "risk_signals", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "source_bundle_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "repository_id": {"type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$"},
    "candidate_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "effective_policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requested_profile": {"enum": ["COMPACT", "STANDARD", "DEEP"]},
    "token_budget": {"type": "integer", "minimum": 0},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh"]},
    "sources": {"type": "object"},
    "risk_signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_failed", "gate_missing", "surviving_mutant", "conflicting_oracle", "prompt_injection_risk", "authority_incomplete", "provenance_incomplete", "reviewer_uncertain", "selector_uncertain"],
      "properties": {
        "gate_failed": {"type": "boolean"},
        "gate_missing": {"type": "boolean"},
        "surviving_mutant": {"type": "boolean"},
        "conflicting_oracle": {"type": "boolean"},
        "prompt_injection_risk": {"type": "boolean"},
        "authority_incomplete": {"type": "boolean"},
        "provenance_incomplete": {"type": "boolean"},
        "reviewer_uncertain": {"type": "boolean"},
        "selector_uncertain": {"const": false}
      }
    },
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"}
  }
}
