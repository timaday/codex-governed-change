{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/evidence-manifest.schema.json",
  "title": "Governed evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "repository_id", "candidate_id", "task_contract", "effective_policy", "authenticated_decisions", "evidence_locators", "sandbox_capabilities", "provenance_statements", "gate_manifest", "required_gate_ids", "gate_results", "mutation_corpus", "mutation_baseline", "mutant_records", "reviewer_qualification", "rapid_review_qualification", "reviewer_qualification_cases", "rapid_review_qualification_cases", "reviewer_qualification_corpus", "reviewer_qualification_label_decision", "context_sources", "context_projection", "context_qualification", "context_receipt", "context_execution_receipt", "reviewer_result", "reviewer_execution", "rapid_review_executions", "rapid_review_context_execution_receipts", "risk_register", "oracle_references", "coverage_notes", "follow_ups", "assurance_case", "created_at", "producer_version"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "manifest_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "task_contract": { "$ref": "#/$defs/reference" },
    "effective_policy": { "$ref": "#/$defs/reference" },
    "proposed_policy": { "$ref": "#/$defs/reference" },
    "lkg_promotion_decision": { "$ref": "#/$defs/reference" },
    "rollback_evidence": { "$ref": "#/$defs/reference" },
    "authenticated_decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "evidence_locators": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "sandbox_capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "provenance_statements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "gate_manifest": { "$ref": "#/$defs/reference" },
    "required_gate_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" } },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "reference"],
        "properties": {
          "gate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
          "reference": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "reviewer_result": { "$ref": "#/$defs/reference" },
    "mutation_corpus": { "$ref": "#/$defs/reference" },
    "mutation_baseline": { "$ref": "#/$defs/reference" },
    "mutant_records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "reviewer_qualification": { "$ref": "#/$defs/reference" },
    "rapid_review_qualification": { "$ref": "#/$defs/reference" },
    "reviewer_qualification_cases": { "$ref": "#/$defs/reference" },
    "rapid_review_qualification_cases": { "$ref": "#/$defs/reference" },
    "reviewer_qualification_corpus": { "$ref": "#/$defs/reference" },
    "reviewer_qualification_label_decision": { "$ref": "#/$defs/reference" },
    "context_sources": { "$ref": "#/$defs/reference" },
    "context_projection": { "$ref": "#/$defs/reference" },
    "context_qualification": { "$ref": "#/$defs/reference" },
    "context_receipt": { "$ref": "#/$defs/reference" },
    "context_execution_receipt": { "$ref": "#/$defs/reference" },
    "reviewer_execution": { "$ref": "#/$defs/reference" },
    "rapid_review_executions": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "rapid_review_context_execution_receipts": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "risk_register": { "$ref": "#/$defs/reference" },
    "oracle_references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "coverage_notes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
    "follow_ups": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "assurance_case": { "$ref": "#/$defs/reference" },
    "risk_assessment": { "$ref": "#/$defs/reference" },
    "rapid_review_charters": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "rapid_review_sessions": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "rapid_review_debrief": { "$ref": "#/$defs/reference" },
    "risk_disposition": { "$ref": "#/$defs/reference" },
    "waiver": { "$ref": "#/$defs/reference" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "producer_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
