{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/provenance-statement.schema.json",
  "title": "Governed-change unsigned provenance statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "statement_id", "_type", "subject", "predicateType", "predicate"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "statement_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        }
      }
    },
    "predicateType": { "const": "https://timaday.github.io/codex-governed-change/attestation/governance-provenance/v1" },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "candidate_id", "task_contract_sha256", "effective_policy_sha256", "gate_definition_sha256", "reviewer_prompt_sha256", "producer", "workflow", "tools", "environment", "materials", "started_at", "ended_at", "result", "limits", "artifacts", "limitations", "signed"],
      "properties": {
        "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
        "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "effective_policy_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "gate_definition_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reviewer_prompt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["builder_id", "implementation_sha256", "version"],
          "properties": {
            "builder_id": { "type": "string", "minLength": 1 },
            "implementation_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "run_id", "attempt"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "run_id": { "type": "string", "minLength": 1 },
            "attempt": { "type": "integer", "minimum": 1 }
          }
        },
        "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nameVersion" } },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_identity", "execution_identity", "sandbox_capability_sha256"],
          "properties": {
            "source_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "execution_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "sandbox_capability_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "result": { "enum": ["PASS", "FAIL", "BLOCK", "UNKNOWN"] },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout_seconds", "max_output_bytes", "process_limit", "memory_bytes"],
          "properties": {
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "max_output_bytes": { "type": "integer", "minimum": 1 },
            "process_limit": { "type": "integer", "minimum": 1 },
            "memory_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reference" } },
        "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "signed": { "const": false }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "nameVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
