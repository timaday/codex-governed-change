{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/review-charter.schema.json",
  "title": "RST-inspired rapid-review charter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "task_contract_sha256", "charter_id", "candidate_id", "risk_assessment_sha256", "mission", "target", "affected_surfaces", "stakeholders", "value_at_risk", "risk_hypotheses", "quality_criteria", "coverage_areas", "techniques", "oracle_heuristics", "resources", "constraints", "timebox_minutes", "required_evidence", "stopping_heuristic", "created_at", "producer_version", "provenance"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "charter_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "risk_assessment_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "mission": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "affected_surfaces": { "$ref": "#/$defs/nonemptyStrings" },
    "stakeholders": { "$ref": "#/$defs/nonemptyStrings" },
    "value_at_risk": { "$ref": "#/$defs/nonemptyStrings" },
    "risk_hypotheses": { "$ref": "#/$defs/nonemptyStrings" },
    "quality_criteria": { "$ref": "#/$defs/nonemptyStrings" },
    "coverage_areas": { "$ref": "#/$defs/nonemptyStrings" },
    "techniques": { "$ref": "#/$defs/nonemptyStrings" },
    "oracle_heuristics": { "$ref": "#/$defs/nonemptyStrings" },
    "resources": { "$ref": "#/$defs/nonemptyStrings" },
    "constraints": { "$ref": "#/$defs/nonemptyStrings" },
    "timebox_minutes": { "type": "integer", "minimum": 1 },
    "required_evidence": { "$ref": "#/$defs/nonemptyStrings" },
    "stopping_heuristic": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "producer_version": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "nonemptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produced_by", "method", "source_refs"],
      "properties": {
        "produced_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "source_refs": { "$ref": "#/$defs/nonemptyStrings" }
      }
    }
  }
}
