{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/reviewer-qualification-cases.schema.json",
  "title": "Reconstructable per-case reviewer qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_evidence_id", "mode", "evaluation_repository_id", "corpus_sha256", "label_decision_id", "identity", "observations"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "case_evidence_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mode": {"enum": ["conformance", "rapid_review"]},
    "evaluation_repository_id": {"type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$"},
    "corpus_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "label_decision_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {"$ref": "#/$defs/identity"},
    "observations": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_sha256", "schema_sha256", "launcher_sha256", "codex_cli_version", "model", "reasoning_effort"],
      "properties": {
        "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "schema_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "launcher_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "codex_cli_version": {"type": "string", "pattern": "^codex-cli [0-9][0-9A-Za-z._+-]{0,63}$"},
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"enum": ["high", "xhigh"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "severity", "requirement_id", "expected_disposition", "observed_disposition", "matched", "task_contract_sha256", "effective_policy_sha256", "candidate", "reviewer_output", "reviewer_execution", "stdout", "stderr"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "control"]},
        "requirement_id": {"type": "string", "minLength": 1},
        "expected_disposition": {"enum": ["BLOCK", "NO_BLOCKING_FINDING_OBSERVED"]},
        "observed_disposition": {"enum": ["BLOCK", "NO_BLOCKING_FINDING_OBSERVED", "UNKNOWN"]},
        "matched": {"type": "boolean"},
        "task_contract_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "effective_policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "candidate": {"$ref": "#/$defs/candidate"},
        "reviewer_output": {"$ref": "#/$defs/reference"},
        "reviewer_execution": {"$ref": "#/$defs/reference"},
        "stdout": {"$ref": "#/$defs/reference"},
        "stderr": {"$ref": "#/$defs/reference"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "candidate_id", "repository_id", "mode", "base_commit", "head_commit", "tracked_diff_sha256", "changed_paths", "untracked_entries", "submodules", "effective_policy_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "candidate_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "repository_id": {"type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$"},
        "mode": {"const": "working_tree"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tracked_diff_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "untracked_entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "mode": {"const": "100644"},
              "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "submodules": {"const": []},
        "effective_policy_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
