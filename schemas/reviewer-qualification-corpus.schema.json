{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/reviewer-qualification-corpus.schema.json",
  "title": "Human-labelled reviewer qualification corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "human_labelled", "cases"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "corpus_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "human_labelled": {"const": true},
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "case_classes", "severity", "requirement_id", "expected_finding", "expected_disposition", "risk", "charter", "files"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"},
          "case_classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["seeded_defect", "prompt_injection", "clean_control"]}
          },
          "severity": {"enum": ["critical", "control"]},
          "requirement_id": {"type": "string", "minLength": 1},
          "expected_finding": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["defect_id", "path", "line"],
            "properties": {
              "defect_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$"},
              "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
              "line": {"type": "integer", "minimum": 1}
            }
          },
          "expected_disposition": {"enum": ["BLOCK", "NO_BLOCKING_FINDING_OBSERVED"]},
          "risk": {"type": "string", "minLength": 1},
          "charter": {"type": "string", "minLength": 1},
          "files": {"type": "object"}
        }
      }
    }
  }
}
