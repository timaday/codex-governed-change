{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/reviewer-result.schema.json",
  "title": "Independent reviewer result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "task_contract_sha256", "effective_policy_sha256", "gate_manifest_sha256", "reviewer_prompt_sha256", "model", "invocation_id", "verdict", "reviewed_surfaces", "findings", "missing_evidence", "claims", "limitations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "effective_policy_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gate_manifest_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reviewer_prompt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "model": { "type": "string", "minLength": 1 },
    "invocation_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$" },
    "verdict": { "enum": ["PASS", "BLOCK", "UNKNOWN"] },
    "reviewed_surfaces": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "path", "claim", "violated_oracle", "evidence", "remediation"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "category": { "enum": ["correctness", "security", "authority", "evidence", "architecture", "test", "specification", "performance", "data", "operations", "ux", "portability"] },
          "path": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "violated_oracle": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "missing_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "classification", "evidence_refs"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["PROVEN", "SUPPORTED", "UNVERIFIED", "UNKNOWN"] },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
