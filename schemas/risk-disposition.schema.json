{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/risk-disposition.schema.json",
  "title": "Finding and residual-risk disposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "risk_disposition_id", "repository_id", "task_contract_sha256", "candidate_id", "debrief_sha256", "items", "state", "human_owned", "approved", "created_at", "producer_version", "provenance"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "risk_disposition_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "debrief_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "state": { "enum": ["READY_FOR_HUMAN", "BLOCK", "UNKNOWN"] },
    "human_owned": { "const": true },
    "approved": { "const": false },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "producer_version": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
        "required": ["item_id", "kind", "severity", "disposition", "rationale", "evidence_refs", "decision_ref"],
      "properties": {
        "item_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$" },
        "kind": { "enum": ["finding", "residual_risk"] },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "disposition": { "enum": ["remediated", "accepted", "deferred", "unknown"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "decision_ref": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produced_by", "method", "source_refs"],
      "properties": {
        "produced_by": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
