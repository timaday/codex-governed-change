{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/risk-register.schema.json",
  "title": "Candidate-bound RST risk register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "risk_register_id", "repository_id", "task_contract_sha256", "candidate_id", "risks", "updated_from", "created_at", "producer_version"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "risk_register_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_id", "description", "threatened_value", "impact", "status", "source_refs", "charter_refs"],
        "properties": {
          "risk_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,127}$" },
          "description": { "type": "string", "minLength": 1 },
          "threatened_value": { "type": "string", "minLength": 1 },
          "impact": { "enum": ["low", "medium", "high", "critical"] },
          "status": { "enum": ["open", "investigating", "mitigated", "accepted", "unknown"] },
          "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "charter_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "updated_from": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "producer_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
