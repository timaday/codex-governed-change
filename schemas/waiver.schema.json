{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timaday.github.io/codex-governed-change/schemas/waiver.schema.json",
  "title": "Human governance waiver",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "waiver_id", "repository_id", "task_contract_sha256", "candidate_id", "effective_policy_sha256", "requirement_ids", "issuance_decision_id", "consumption_decision_id", "rationale", "compensating_controls", "created_at", "expires_at", "single_use"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "waiver_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repository_id": { "type": "string", "pattern": "^repo:[a-z0-9][a-z0-9._/-]{2,255}$" },
    "task_contract_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "candidate_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "effective_policy_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^GOV-([0-9]{3}|TOKEN-[0-9]{3})$" } },
    "issuance_decision_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "consumption_decision_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rationale": { "type": "string", "minLength": 1 },
    "compensating_controls": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "single_use": { "const": true }
  },
  "$defs": {
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }
  }
}
